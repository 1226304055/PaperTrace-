# DashScope OpenAI-compatible API
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Models
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-max
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local storage
PDF_DIR=./pdfs
DATA_DIR=./chroma_db
CHROMA_DB_DIR=./chroma_db/vectors
IMAGES_DIR=./images
SQLITE_DB_PATH=./chroma_db/papertrace.db
EMBEDDING_CACHE_DIR=./chroma_db/models

# Retrieval and reliability
TOP_K=5
RETRIEVAL_CANDIDATES=20
LEXICAL_SCAN_LIMIT=5000
HISTORY_TURNS=4
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1.0
CAPTION_WORKERS=4
VISION_MAX_TOKENS=280
MAX_UPLOAD_MB=50
